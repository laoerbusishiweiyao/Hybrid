{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "http://+:12345"
      }
    }
  },
  "FileServer": {
    "VuePath": "vue",
    "BucketPath": "bucket"
  },
  "ConnectionStrings": {
    "MySqlConnection": "Server=192.168.0.50;Database=d26-001;User=jiuzhou;Password=123456;AllowPublicKeyRetrieval=true;"
  },
  "StaticPath": "static",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Expressions"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "./Logs/EdgeServer.Verbose.log",
          "restrictedToMinimumLevel": "Verbose",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "./Logs/EdgeServer.Debug.log",
          "restrictedToMinimumLevel": "Debug",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "./Logs/EdgeServer.Information.log",
          "restrictedToMinimumLevel": "Information",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "./Logs/EdgeServer.Warning.log",
          "restrictedToMinimumLevel": "Warning",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "./Logs/EdgeServer.Error.log",
          "restrictedToMinimumLevel": "Error",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "./Logs/EdgeServer.Fatal.log",
          "restrictedToMinimumLevel": "Fatal",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Destructure": [],
    "Properties": {}
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://127.0.0.1:28087/"
          }
        }
      }
    }
  }
}