<Window x:Class="Hybrid.Native.Windows.WebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Hybrid.Native.Windows"
        xmlns:wpf="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        mc:Ignorable="d"
        Title="WebWindow"
        AllowsTransparency="True" Background="Transparent"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <DockPanel>
        <wpf:ChromiumWebBrowser x:Name="Browser" />
    </DockPanel>

</Window>