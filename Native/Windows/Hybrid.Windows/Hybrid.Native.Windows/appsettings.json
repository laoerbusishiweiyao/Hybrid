{
  "LaunchOptions": {
    "ProcessId": 0,
    "Left": 0,
    "Top": 0,
    "Width": 2560,
    "Height": 1440,
    "NamedPipeName": "wpf-unity",
    "Address": "https://192.168.10.31:12345/",
    "ShowDevTools": true
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Expressions"
    ],
    "MinimumLevel": "Verbose",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "../Logs/Hybrid.Native.Windows.Verbose.log",
          "restrictedToMinimumLevel": "Verbose",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "../Logs/Hybrid.Native.Windows.Debug.log",
          "restrictedToMinimumLevel": "Debug",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "../Logs/Hybrid.Native.Windows.Information.log",
          "restrictedToMinimumLevel": "Information",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "../Logs/Hybrid.Native.Windows.Warning.log",
          "restrictedToMinimumLevel": "Warning",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "../Logs/Hybrid.Native.Windows.Error.log",
          "restrictedToMinimumLevel": "Error",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "../Logs/Hybrid.Native.Windows.Fatal.log",
          "restrictedToMinimumLevel": "Fatal",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Destructure": [],
    "Properties": {}
  }
}